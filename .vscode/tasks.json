{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Chọn bản và chạy Space Shooter",
            "type": "shell",
            "command": "./build_run_spaceshooter.sh",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "Build Android APK",
            "type": "shell",
            "command": "source tools/android_env.sh && space_android_env \"$PWD\" && ./gradlew :android:assembleDebug -Pandroid.builder.sdkDownload=false",
            "options": {"shell": {"executable": "/bin/bash", "args": ["-c"]}},
            "group": "build",
            "problemMatcher": []
        }
    ]
}
